# Copy to .env (or set these in your host's dashboard). All are OPTIONAL —
# Ida runs fully without any of them, in local-only + curated mode.

# Cross-device sync: a Postgres connection string (Neon's free tier works great).
# Get one free at https://neon.tech → create a project → copy the connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Live Ida (Claude-powered chat). Without this, Ida uses the built-in expert brain.
# ANTHROPIC_API_KEY=sk-ant-...
# IDA_MODEL=claude-sonnet-4-6

# Port (defaults to 3000)
# PORT=3000
